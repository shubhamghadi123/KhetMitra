<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nestedScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F0"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Drag Handle -->
        <View
            android:id="@+id/dragHandle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:background="#52B788"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvManualTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:text="Let's find your soil type"
            android:textColor="#1A3C2E"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dragHandle"
            tools:ignore="HardcodedText" />

        <!-- Ribbon Test Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRibbonTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#1A3C2E"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvManualTitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <!-- Glow circle decoration -->
                <View
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:alpha="0.15"
                    android:background="@drawable/bg_circle_glow_green"
                    android:layout_marginEnd="-20dp"
                    android:layout_marginTop="-20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Icon tile -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/iconTileRibbon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    app:cardBackgroundColor="#2D6A4F"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🪨"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Card header label -->
                <TextView
                    android:id="@+id/tvRibbonTestLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="The Ribbon Test"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/iconTileRibbon"
                    app:layout_constraintStart_toEndOf="@id/iconTileRibbon"
                    app:layout_constraintTop_toTopOf="@id/iconTileRibbon"
                    tools:ignore="HardcodedText" />

                <!-- Description -->
                <TextView
                    android:id="@+id/tvRibbonTestDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Squeeze a handful of wet soil. What happens?"
                    android:textColor="#A8D5B5"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iconTileRibbon"
                    tools:ignore="HardcodedText" />

                <!-- How to test link -->
                <TextView
                    android:id="@+id/tvHowToTest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingVertical="4dp"
                    android:text="ⓘ How to do this test?"
                    android:textColor="#52B788"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvRibbonTestDesc"
                    tools:ignore="HardcodedText" />

                <!-- Ribbon Test RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRibbonTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="0dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/tvHowToTest"
                    tools:listitem="@layout/item_ribbon_test" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 2: Filtered Soils Header -->
        <TextView
            android:id="@+id/tvStep2Header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="22dp"
            android:text="Select the specific soil color / type:"
            android:textColor="#1A3C2E"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardRibbonTest"
            tools:ignore="HardcodedText" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFilteredSoils"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvStep2Header"
            tools:listitem="@layout/item_soil_type" />

        <!-- OR Divider -->
        <LinearLayout
            android:id="@+id/dividerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/rvFilteredSoils">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D8E5D0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="OR"
                android:textColor="#888888"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D8E5D0" />

        </LinearLayout>

        <!-- Previous Crop Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPreviousCrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#E8EDE0"
            app:strokeWidth="1.5dp"
            app:layout_constraintTop_toBottomOf="@id/dividerLayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Icon tile -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/iconTileCrop"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardBackgroundColor="#FFF7ED"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#33F97316"
                    app:strokeWidth="1dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🌾"
                        android:textSize="20sp"
                        tools:ignore="HardcodedText" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Crop title + desc -->
                <TextView
                    android:id="@+id/tvCropLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Tell us what you grew last"
                    android:textColor="#1A3C2E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iconTileCrop"
                    app:layout_constraintTop_toTopOf="@id/iconTileCrop"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvCropDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:text="We can estimate your soil type based on your previous harvest."
                    android:textColor="#888888"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iconTileCrop"
                    app:layout_constraintTop_toBottomOf="@id/tvCropLabel"
                    tools:ignore="HardcodedText" />

                <!-- Dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/menuPreviousCrop"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Select previous crop"
                    app:layout_constraintTop_toBottomOf="@id/iconTileCrop"
                    tools:ignore="HardcodedText">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteCrop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        tools:ignore="LabelFor" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Estimated soil result text -->
                <TextView
                    android:id="@+id/tvEstimatedCropText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#52B788"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/menuPreviousCrop" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:text="Save Farm Profile"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#52B788"
            app:cornerRadius="18dp"
            app:elevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/cardPreviousCrop"
            tools:ignore="HardcodedText" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>